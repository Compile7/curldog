{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moniwork",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hb/*"]
  },
  // Every minute: run due monitors and reminders. Hourly: prune, expiry checks, Monday weekly report.
  "triggers": { "crons": ["* * * * *"] },
  // Workers AI: a short explanation when a monitor goes down (once per incident).
  "ai": { "binding": "AI" },
  // One Durable Object per region runs checks for monitors with "check from 3 regions" on.
  "durable_objects": { "bindings": [{ "name": "PROBER", "class_name": "Prober" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Prober"] }],
  // No database_id: Wrangler creates the database on first deploy and reuses it after.
  "d1_databases": [{ "binding": "DB", "database_name": "moniwork", "migrations_dir": "migrations" }],
  // Settings live in the dashboard (Worker → Settings → Variables and Secrets), not in this file:
  //   ACCESS_TEAM_DOMAIN  e.g. "acme.cloudflareaccess.com"  (required)
  //   ACCESS_AUD          Access application audience tag    (required)
  //   APP_URL             e.g. "https://status.acme.com"      (optional, links in alerts)
  // keep_vars stops a deploy from wiping them.
  "keep_vars": true,
  "observability": { "enabled": true }
}
